# Copy this file to .env and provide credentials for the services you use.
# Never commit the populated .env file.

# LLM providers
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=

# Yahoo Finance (initial data source; no API key required by yfinance)
YAHOO_FINANCE_ENABLED=true

# SEC EDGAR
# Requests should identify the application and include a monitored email.
# Example: AAI-520 Financial Research Team team@example.com
SEC_USER_AGENT=

# FRED
FRED_API_KEY=

# NewsAPI
NEWS_API_KEY=

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=

# Application defaults
DEFAULT_TICKER=AAPL
MAX_OPTIMIZER_ITERATIONS=3
EVALUATION_SCORE_THRESHOLD=0.80
MEMORY_PATH=data/memory/research_memory.json
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
