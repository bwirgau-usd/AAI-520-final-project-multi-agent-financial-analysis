# Copy this file to .env and provide credentials for the services you use.
# Never commit the populated .env file.

# LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional financial and news data providers
NEWS_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# SEC requests should identify the application and include a monitored email.
# Example: AAI-520 Financial Research Team team@example.com
SEC_USER_AGENT=

# Application defaults
DEFAULT_TICKER=AAPL
MAX_OPTIMIZER_ITERATIONS=3
EVALUATION_SCORE_THRESHOLD=0.80
MEMORY_PATH=data/memory/research_memory.json
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

